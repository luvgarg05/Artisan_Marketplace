# Copy this file to backend/.env and fill in the values. Never commit .env.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Same project ID as REACT_APP_FIREBASE_PROJECT_ID in the frontend
FIREBASE_PROJECT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
# Comma-separated frontend URLs allowed to call the API (leave empty for local dev)
ALLOWED_ORIGINS=http://localhost:3000
